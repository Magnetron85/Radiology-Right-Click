# User state -- never commit
preferences.json
preferences.backup.json
preferences.ini
preferences.ini.imported
preferences*.tmp

# Local references folder (may contain copyrighted PDFs)
/References/
/references/

# v1 reference kept locally for porting; not part of the v2 release
/_v1_reference/

# Icon source / preview -- the generated RightClick.ico ships at the project
# root and the script loads it; only the .py source and PNG previews stay
# local. (RightClick.ico is intentionally NOT gitignored.)
/_design/

# Compiled binary -- ship via GitHub Releases, not the source tree
RightClick.exe
*.exe

# Tests -- development only, not part of the release
/tests/

# Internal working draft -- not part of the release
IMPRESSION_STYLE.md

# Claude Code working dir -- never push any of it (personal, machine-specific)
.claude/

# Debug log -- may contain captured clipboard text (PHI) when debug capture is on
debug.log
*.log

# Python cruft
__pycache__/
*.pyc

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini

# Misc
*.tmp
*.bak
*~
~$*
